@article{daubechies2006imperfect,
	abstract = {{This paper analyzes mathematically the effect of quantizer threshold imperfection commonly encountered in the circuit implementation of analog-to-digital (A/D) converters such as pulse code modulation (PCM) and sigma--delta \$(\textbackslashSigma\textbackslashDelta)\$ modulation. \$\textbackslashSigma\textbackslashDelta\$ modulation, which is based on coarse quantization of oversampled (redundant) samples of a signal, enjoys a type of self-correction property for quantizer threshold errors (bias) that is not shared by PCM. Although ``classical'' \$\textbackslashSigma\textbackslashDelta\$ modulation is inferior to PCM in the rate-distortion sense, this robustness feature is believed to be one of the reasons why \$\textbackslashSigma\textbackslashDelta\$ modulation is preferred over PCM in A/D converters with imperfect quantizers. Motivated by these facts, other encoders are constructed in this paper that use redundancy to obtain a similar self-correction property, but that achieve higher order accuracy relative to bit rate compared to classical \$\textbackslashSigma\textbackslashDelta\$. More precisely, two different types of encoders are introduced that exhibit exponential accuracy in the bit rate (in contrast to the polynomial-type accuracy of classical \$\textbackslashSigma\textbackslashDelta\$) while possessing the self-correction property.}},
	author = {Daubechies, Ingrid and DeVore, Ronald A. and G{\"u}nt{\"u}rk, C. Sinan and Vaishampayan, Vinay A.},
	doi = {10.1109/tit.2005.864430},
	issn = {0018-9448},
	journal = {IEEE Transactions on Information Theory},
	local-url = {file://localhost/Users/valentinabadie/Documents/Travail/PhD_ETH/Material/Quantization/imperfect-quantizers-daubechies.pdf},
	number = {3},
	pages = {874--885},
	title = {{A/D conversion with imperfect quantizers}},
	volume = {52},
	year = {2006},
	bdsk-file-1 = {},
	bdsk-url-1 = {https://doi.org/10.1109/tit.2005.864430}}



