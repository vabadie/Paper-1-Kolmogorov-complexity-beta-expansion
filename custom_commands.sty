%%% this file contains commands to be used often for quicker use


%some operators
\newcommand\ev{\operatorname{ev}}
\newcommand\rg{\operatorname{range}}
\newcommand\len[1]{\ensuremath{\left| #1 \right|}}

% big O notations
\newcommand{\constw}[1]{\underset{|#1| \to \infty}{\mathcal{O}}(1)}
\newcommand{\constn}[1]{\underset{#1 \to \infty}{\mathcal{O}}(1)}

%around the symbol beta
\newcommand\betaf{\pmb{\beta}}
\newcommand\betaprox{\ensuremath{\underline{\smash{\beta}}}}
\newcommand\betaun{\ensuremath{\beta \hspace{-1mm} - \hspace{-1mm} 1}}
\newcommand\lowbeta{\underline{\smash{\beta}}}

% beta-expansions notations
\newcommand\Ibet{\ensuremath{\left[0, \frac{\lceil \beta\rceil - 1}{\beta - 1}\right)}}
\newcommand\ibet{\ensuremath{\left[0, \frac{1}{\beta - 1}\right]}}
\newcommand\ib{\ensuremath{I_\beta}}
\newcommand\grpref{\ensuremath{d_\beta^N \hspace{-1mm} }}
\newcommand\qbet{\ensuremath{\left\{ 0, \ldots, \lceil \beta\rceil - 1 \right\}}}
\newcommand\Mbet{\ensuremath{\frac{\lceil \beta \rceil -1}{\beta - 1}}}


% Kolmogorov complexity notations
\newcommand\Uref{\ensuremath{\UU_{\operatorname{ref}}}}

% creates an environment in which everything is written a little bit translucid, so that it is clear that this is doubtful.
\newenvironment{doubtfulsec}{%
    \begingroup
    \color{black!20}%
}{%
    \endgroup
}