% beta-expansions notations
\newcommand\sets[1][\base]{\ensuremath{\Sigma_{#1}}} %notation for the set of beta-expansions of the real number s
\newcommand\setad[1][\base]{\ensuremath{\Omega_{#1}}} %notation for the set of sequences that can be a beta expansion (admissible sequences)
\newcommand\grd[1][\base]{\ensuremath{\gf_{#1}}} %notation for the greedy beta expansion
\newcommand\eval[1][\base]{\ensuremath{\delta_{#1}}} %notation for the beta-valuation operator
\newcommand\mdig[1][\base]{\ensuremath{\lceil #1 \rceil -1}} %notation for the maximal digit of the beta expansions
\newcommand\Ibet{\ensuremath{\left[0, \frac{\lceil \beta\rceil - 1}{\beta - 1}\right)}}
\newcommand\ibet{\ensuremath{\left[0, \frac{1}{\beta - 1}\right]}}
\newcommand\ib{\ensuremath{I_\beta}}
\newcommand\grpref{\ensuremath{d_\beta^N \hspace{-1mm} }}
\newcommand\qbet{\ensuremath{\left\{ 0, \ldots, \lceil \beta\rceil - 1 \right\}}}
\newcommand\Mbet{\ensuremath{\frac{\lceil \beta \rceil -1}{\beta - 1}}}


% Kolmogorov complexity notations
\newcommand\Uref{\ensuremath{\UU_{\operatorname{ref}}}}

