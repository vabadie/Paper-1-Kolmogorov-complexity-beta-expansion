%%% Greedy beta-expansion functions/maps/sets notations
\newcommand\setGreedyExpansions[1][\base]{\ensuremath{\widehat{\Omega}_{#1}}} %notation for the set of beta-expansions of the real number s
\newcommandx\setBetaExpansions[2][1=,2=\base]{%notation for the set of sequences that can be a beta expansion
    \ifthenelse{\equal{#1}{}}{\ensuremath{\Omega_{#2}}}{\ensuremath{\Omega_{#2}(#1)}
    }
} 
\newcommandx\setBetaPrefixes[3][1=,2=\iga,3=\base]{%notation for the set of beta prefixes
    \ifthenelse{\equal{#1}{} \AND \equal{#2}{}}{\ensuremath{W_{#3}}}{
        \ifthenelse{\equal{#2}{}}{
            \ensuremath{W_{#3}^\ast(#1)}
        }{\ensuremath{W_{#3,#2}(#1)}}
    }
}
\newcommandx\setBetadics[3][1=,2=\iga,3=\base]{%notation for the set of betadics
\ifthenelse{\equal{#1}{} \AND \equal{#2}{}}{\ensuremath{\mathbb{Q}_{#3}}}{
    \ifthenelse{\equal{#2}{}}{
        \ensuremath{\mathbb{Q}_{#3}(#1)}
        }{
            \ifthenelse{\equal{#1}{}}{
            \ensuremath{\mathbb{Q}_{#3,#2}}
            }{\ensuremath{\mathbb{Q}_{#3,#2}(#1)}}
        }
    }
}
\newcommand\trans[1][\base]{\ensuremath{T_{#1}}} %notation for the beta-transformation map
\newcommand\digz[1][\base]{\ensuremath{d_{#1}}} %notation for the beta-digitization map
\newcommand\grd[1][\base]{\ensuremath{\gf_{#1}}} %notation for the greedy beta expansion
\newcommandx\eval[2][1=,2=\base]{%notation for the beta-valuation operator
    \ifthenelse{\equal{#1}{}}{\ensuremath{\delta_{#2}}}{
        \ensuremath{\delta_{#2}\left(#1\right)}
    }
} 
\renewcommand\sup[1][]{
    \ifthenelse{\equal{#1}{}}{\ensuremath{\mathop{\operatorname{sup}}}}{
        \ensuremath{\mathop{\operatorname{sup}}}\left(#1\right)
    }
}


\newcommand\vrr[1][\base]{\ensuremath{V_{#1}}} %difference set of real number corresponding to finite greedy expansions of size n+1 and n

\newcommandx\betadicSolver[3][1=,2=\iga,3=\base]{%n order betadic solver
    \ifthenelse{\equal{#1}{}}{
        \ensuremath{\mathcal{S}_{#3,#2}}
    }{
        \ensuremath{\mathcal{S}_{#3,#2}}\left(#1\right)
    }
} 
\newcommandx\betaPrefixSolver[3][1=,2=\iga,3=\base]{%n order beta prefix solver
    \ifthenelse{\equal{#1}{}}{
        \ensuremath{\mathcal{S}^{\operatorname{lex}}_{#3,#2}}
    }{
        \ensuremath{\mathcal{S}^{\operatorname{lex}}_{#3,#2}\left(#1\right)}
    }
} 

\newcommandx\indexBetadicSolver[3][1=,2=\iga,3=\base]{%n order betadic solver
    \ifthenelse{\equal{#1}{}}{
        \ensuremath{I_{#3,#2}}
    }{
        \ensuremath{I_{#3,#2}}\left(#1\right)
    }
} 
\newcommandx\indexBetaPrefixSolver[3][1=,2=\iga,3=\base]{%n order beta prefix solver
    \ifthenelse{\equal{#1}{}}{
        \ensuremath{I^{\operatorname{lex}}_{#3,#2}}
    }{
        \ensuremath{I^{\operatorname{lex}}_{#3,#2}\left(#1\right)}
    }
} 

%%% Beta-expansion digit/sets notation
\newcommand\betaint{0}
\newcommandx\ndig[2][1=\base, 2=\betaint]{\ifthenelse{
    \equal{#2}{0}
}{\ensuremath{\lceil #1 \rceil}}
{\ensuremath{\the\numexpr #2 + 1 \relax}}} %notation for the maximal digit of the beta expansions
\newcommandx\mdig[2][1=\base, 2=\betaint]{\ifthenelse{
    \equal{#2}{0}
}{\ensuremath{\lceil #1 \rceil - 1}}
{{\ensuremath{ #2 }}}} %notation for the maximal digit of the beta expansions
\newcommandx\digs[2][1=\base, 2=\betaint]{\ensuremath{\listIntegers[{\mdig[#1][#2]}][0]}} %notation for the digits of the beta-expansion
\newcommandx\rangeEvalMax[2][1=\base, 2=\betaint]{\ifthenelse{
    \equal{#2}{0}
}{\ensuremath{\frac{\mdig[#1]}{#1 - 1}}}
{\ensuremath{ \frac{#2}{#1 - 1}}}} %maximal real number reachable with beta expansions
\newcommandx\rangeEval[2][1=\base,2=\betaint]{\left[0, \rangeEvalMax[\base][\betaint] \right]} %%% displays the set of possible real numbers having beta expansions
\newcommand\ib[1][\base]{\ensuremath{I_{#1}}} %% abbrev of the set of possible real numbers having beta-expansions


%%% Beta-expansion prefixes/beta-adic numbers notation
\newcommandx\setGreedyBetaPrefixes[2][1=none,2=\base]{%set of greedy beta prefixes
\ifthenelse{
    \equal{#1}{none}}{\ensuremath{\widehat{W}_{#2}}}{
        \ensuremath{\widehat{W}_{#2,#1}}
    }
}
\newcommandx\setGreedyBetadics[2][1=none,2=\base]{%set of greedy betadic numbers
    \ifthenelse{
        \equal{#1}{none}}{\ensuremath{\widehat{\mathbb{Q}}_{#2}}}{
            \ensuremath{\widehat{\mathbb{Q}}_{#2,#1}}
        }
} 
\newcommandx\setGreedyBetadicsWithOne[2][1=,2=\base]{%set of greedy betadic numbers including the number one
    \ifthenelse{
        \equal{#1}{}}{\ensuremath{\widehat{\mathbb{Q}}^+_{#2}}}{
            \ensuremath{\widehat{\mathbb{Q}}^+_{#2,#1}}
        }
} 
\newcommandx\numberGreedyPrefixes[2][1=none,2=\base]{ %number of greedy prefixes or greedy betadic numbers
    \ifthenelse{
    \equal{#1}{none}}{\ensuremath{N_{#2}}}{
        \ensuremath{N_{#2}({#1})}
    }
}
\newcommandx\indicesGreedyPrefixes[2][1=none,2=\base]{%indices of greedy prefixes or greedy betadic numbers
            \ensuremath{\listIntegers[{\numberGreedyPrefixes[#1][#2]-1}][0]}
}
\newcommandx\enumerationBetadics[3][1=\igb,2=\iga,3=\base]{ %enumeration of greedy betadic numbers
    \ifthenelse{
    \equal{#1}{}}{\ensuremath{q_{#3,#2}}}{
        {\ensuremath{q_{#3,#2}(#1)}}
    }
}

\newcommandx\enumerationGreedyPrefixes[3][1=\igb,2=\iga,3=\base]{%enumeration of greedy prefixes
    \ifthenelse{
    \equal{#1}{}}{\ensuremath{\woa_{#3,#2}}}{
        {\ensuremath{\woa_{#3,#2}(#1)}}
    }
}

\newcommandx\indexBetadics[3][1=\woa,2=\iga,3=\base]{%enumeration of greedy prefixes
    \ifthenelse{
    \equal{#1}{}}{\ensuremath{\operatorname{ind}_{#3,#2}}}{
        {\ensuremath{\operatorname{ind}_{#3,#2}(#1)}}
    }
}

%%% Beta-expansion variation sets prefixes/beta-adic numbers notation
\newcommandx\variationSetGreedyBetadics[3][1=,2=,3=\base]{%set of greedy betadic numbers
\ifthenelse{
    \equal{#1}{} \OR \equal{#2}{}}{\setGreedyBetadics[#2][#3]}{
        \ensuremath{\partial_#1\setGreedyBetadics[#2][#3]}
    }
}
\newcommandx\variationSetGreedyPrefixes[3][1=,2=,3=\base]{%set of greedy betadic numbers
\ifthenelse{
    \equal{#1}{} \OR \equal{#2}{}}{\setGreedyBetaPrefixes[#2][#3]}{
        \ensuremath{\partial_#1\setGreedyBetaPrefixes[#2][#3]}
    }
}


