% Limits and big O notations
\newcommand{\limu}[2]{\ensuremath{\underset{#1 \to #2}{\lim}}} %limit with 2 arguments, 1 for the variable, and 1 for the limit to which the variable tends to
\newcommand{\limi}[1]{\ensuremath{\underset{#1 \to \infty}{\lim}}} %limit to infinity with 1 argument, that is the variable of the limit
\newcommand\bigOx[2][const]{
    \ifthenelse{\equal{#1}{1}}{\underset{|#1| \to \infty}{\mathcal{O}}(1)}{\underset{#2 \to \infty}{\mathcal{O}}(#2#1)}} %big O notations
  \newcommand\bigOw[2][const]{
    \ifthenelse{\equal{#1}{1}}{\underset{|#1| \to \infty}{\mathcal{O}}(1)}{\underset{|#2| \to \infty}{\mathcal{O}}(|#2|#1)}} %big O notations on the length of a sequence
