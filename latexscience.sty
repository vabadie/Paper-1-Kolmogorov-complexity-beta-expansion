\ExplSyntaxOn 
\newcommandx{\igflex}[1][1=0]{ % standard rational number notation
  \str_case:nnF { #1 } {
    { 1 } { i }
    { 2 } { j }
    { 3 } { k }
    { 4 } { \ell }
    { 5 } { m }
    { 6 } { p }
  } { n }
}
\newcommand\iga{{\igflex[0]}} % first standard notation for integers
\newcommand\igb{{\igflex[1]}} % second standard notation for integers
\newcommand\igc{{\igflex[2]}} % third standard notation for integers
\newcommand\igd{{\igflex[3]}} % fourth standard notation for integers
\newcommand\ige{{\igflex[4]}} % fifth standard notation for integers
\newcommand\igf{{\igflex[5]}} % sixth standard notation for integers
\newcommand\igg{{\igflex[6]}} % seventh standard notation for integers

\newcommandx{\ra}[1][1=0]{ % standard rational number notation
  \str_case:nnF { #1 } {
    { 1 } { r }
  } { q }
}
\newcommandx{\re}[1][1=0]{ % standard real number notation
  \str_case:nnF { #1 } {
    { 1 } { y }
    { 2 } { z }
  } { x }
}
\newcommand\rea{{\re[0]}} % first standard real number notation
\newcommand\reb{{\re[1]}} % second standard real number notation
\newcommand\rec{{\re[2]}} % third standard real number notation
\newcommand\co{z} % standard complex number notation
\newcommand\bo{b} % standard boolean notation

\newcommandx{\wo}[1][1=0]{ % standard word notation
  \str_case:nnF { #1 } {
    { 1 } { u }
    { 2 } { v }
    { 3 } { y }
    { 4 } { z }
  } { w }
}
\newcommand\woa{{\wo[0]}} % first standard word notation
\newcommand\wob{{\wo[1]}} % second standard word notation
\newcommand\woc{{\wo[2]}} % third standard word notation

\newcommandx{\sq}[1][1=0]{ % standard symbol sequence notation
  \str_case:nnF { #1 } {
    { 1 } { {\bf u} }
    { 2 } { {\bf v} }
    { 3 } { {\bf x} }
    { 4 } { {\bf y} }
  } { {\bf w} }
}
\newcommand\sqa{{\sq[0]}} % first standard symbol sequence notation
\newcommand\sqb{{\sq[1]}} % second standard symbol sequence notation

\newcommandx{\iv}[1][1=0]{ % standard interval notation
  \str_case:nnF { #1 } {
    { 1 } { J }
    { 2 } { K }
  } { I }
}
\newcommand\iva{{\iv[0]}} % first standard notation for intervals
