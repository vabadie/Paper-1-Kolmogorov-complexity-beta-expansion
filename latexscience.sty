%%%%%%%%%%%%%%% Commands for theorems/definitions %%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Special font when introducing a new variable
\newcommand\newname[1]{\textit{#1}}

% Theorem/properties styles
\newtheorem{conjecture}{Conjecture}[section]
\newtheorem{theorem}{Theorem}[section]
\newtheorem{thesis}{Thesis}
\newtheorem{property}{Proposition}[section]
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{corollary}[theorem]{Corollary}
\newtheorem{definition}{Definition}[section]
\newtheorem{notation}[definition]{Notation}
\newtheorem{example}{Example}


\newtheoremstyle{flexith}{}{}{\mdseries}{}{\itshape}{}{.5em}{\textit{\textbf{Theorem}}  \thmnumber{#2}: (#3).}
\theoremstyle{flexith}

\newtheorem{flexitheoreminner}{Theorem}
\newenvironment{flexitheorem}[1]{
  \renewcommand\theflexitheoreminner{#1}%
  \flexitheoreminner
}{\endflexitheoreminner}

\newtheoremstyle{flexide}{}{}{\mdseries}{}{\itshape}{}{.5em}{\textit{\textbf{Definition}}  \thmnumber{#2}: (#3).}
\theoremstyle{flexide}

\newtheorem{flexidefinitioninner}{Definition}
\newenvironment{flexidefinition}[1]{
  \renewcommand\theflexidefinitioninner{#1}%
  \flexidefinitioninner
}{\endflexidefinitioninner}

\newtheoremstyle{flexile}{}{}{\mdseries}{}{\itshape}{}{.5em}{\textit{\textbf{Lemma}}  \thmnumber{#2}: (#3).}
\theoremstyle{flexile}

\newtheorem{flexilemmainner}{Lemma}
\newenvironment{flexilemma}[1]{
  \renewcommand\theflexilemmainner{#1}%
  \flexilemmainner
}{\endflexilemmainner}


%%%%%%%%%%%%%%% Miscellaneous commands %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Special command (osetlem) to quote a Lemma/Theorem inside of an equation
\makeatletter
\newcommand{\oset}[3][0ex]{%this command is a flexible way to put something on top of an element in an equation
  \mathrel{\mathop{#3}\limits^{
    \vbox to#1{\kern-2\ex@
    \hbox{$\scriptstyle #2$}\vss}}}}
\makeatother

\newcommand{\osetlem}[3][1.8ex]{\oset[#1]{\substack{\hspace{.07cm} \text{\tiny Lem.}\\ #2}}{#3}} % This is the command above but applied specially to the case of referencing a Lemma

\newcommand\under[2]{\underset{#2}{\underbrace{#1}}}% Special command (osetlem) to quote a Lemma/Theorem inside of an equation

% creates an environment in which everything is written a little bit translucid, so that it is clear that this is doubtful.
\newenvironment{doubtfulsec}{%
    \begingroup
    \color{black!20}%
}{%
    \endgroup
}